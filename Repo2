<link href="https://fonts.googleapis.com/css2?family=Bitter:wght@500;600;700;800&family=Work+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1E2723;
    --ink-soft:#3B463F;
    --paper:#EFE6D2;
    --paper-light:#F8F3E6;
    --card:#FFFDF8;
    --chalk:#123524;
    --chalk-dark:#0C2A1C;
    --naija:#00814A;
    --naija-dark:#026A3C;
    --stamp:#B23A2E;
    --gold:#C88A2E;
    --line: rgba(30,39,35,0.14);
    --shadow: 0 10px 30px rgba(12,42,28,0.14);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.01ms !important; transition-duration:0.01ms !important;}
  }

  body{
    margin:0;
    font-family:'Work Sans', sans-serif;
    color:var(--ink);
    background:var(--paper);
    line-height:1.55;
  }

  h1,h2,h3,h4{
    font-family:'Bitter', serif;
    color:var(--chalk);
    margin:0 0 0.5em 0;
    line-height:1.15;
  }

  a{color:inherit;}
  img{max-width:100%; display:block;}

  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.72rem;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--naija-dark);
    font-weight:600;
    display:inline-flex;
    align-items:center;
    gap:0.5em;
    margin-bottom:0.9em;
  }
  .eyebrow::before{
    content:"";
    width:22px; height:2px;
    background:var(--gold);
    display:inline-block;
  }

  .wrap{
    max-width:1120px;
    margin:0 auto;
    padding:0 24px;
  }

  /* Ruled paper texture used behind several sections */
  .ruled{
    background-image: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 35px,
      var(--line) 36px
    );
  }

  /* ---------------- HEADER ---------------- */
  header{
    position:sticky; top:0; z-index:100;
    background:var(--chalk);
    border-bottom:3px solid var(--gold);
  }
  .nav-inner{
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 24px;
    max-width:1120px;
    margin:0 auto;
  }
  .brand{
    display:flex; align-items:center; gap:10px;
    font-family:'Bitter', serif;
    font-weight:700;
    font-size:1.15rem;
    color:#fff;
    text-decoration:none;
  }
  .brand-mark{
    width:34px; height:34px;
    border-radius:50%;
    background:var(--naija);
    display:flex; align-items:center; justify-content:center;
    font-family:'IBM Plex Mono', monospace;
    font-weight:700;
    color:#fff;
    font-size:0.9rem;
    flex-shrink:0;
  }
  nav ul{
    list-style:none; display:flex; gap:28px; margin:0; padding:0;
  }
  nav a{
    text-decoration:none;
    color:#EDE6D3;
    font-size:0.95rem;
    font-weight:500;
    padding:6px 2px;
    border-bottom:2px solid transparent;
    transition:border-color .2s ease, color .2s ease;
  }
  nav a:hover, nav a:focus-visible{
    color:#fff;
    border-bottom-color:var(--gold);
  }
  .nav-toggle{
    display:none;
    background:none; border:1px solid #EDE6D3; color:#EDE6D3;
    border-radius:6px; padding:8px 10px; font-size:1rem; cursor:pointer;
  }
  .theme-toggle{
    background:none;
    border:1px solid rgba(237,230,211,0.4);
    color:#EDE6D3;
    width:38px; height:38px;
    border-radius:50%;
    font-size:1rem;
    cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    margin-left:14px;
    flex-shrink:0;
    transition:border-color .2s ease, transform .2s ease;
  }
  .theme-toggle:hover{ border-color:var(--gold); transform:rotate(-12deg); }
  @media (max-width:820px){
    .theme-toggle{ margin-left:8px; width:34px; height:34px; }
  }
  @media (max-width:820px){
    nav{
      position:absolute; top:100%; left:0; right:0;
      background:var(--chalk);
      border-bottom:3px solid var(--gold);
      display:none;
    }
    nav.open{ display:block; }
    nav ul{ flex-direction:column; gap:0; padding:8px 24px 18px; }
    nav ul li{ border-top:1px solid rgba(255,255,255,0.08); }
    nav ul li a{ display:block; padding:12px 4px; }
    .nav-toggle{ display:inline-block; }
  }

  a:focus-visible, button:focus-visible, summary:focus-visible{
    outline:3px solid var(--gold);
    outline-offset:2px;
  }

  /* ---------------- DARK MODE ---------------- */
  body.dark{
    --paper:#141C17;
    --paper-light:#1B2620;
    --card:#1F2B24;
    --ink:#E9E4D3;
    --ink-soft:#B7BFB4;
    --line: rgba(233,228,211,0.14);
    --shadow: 0 10px 30px rgba(0,0,0,0.4);
  }
  body.dark h1, body.dark h2, body.dark h3, body.dark h4{
    color:#E9E4D3;
  }
  body.dark .subject-row:nth-child(odd){ background:rgba(0,129,74,0.09); }
  body.dark .resource-card .icon{ background:var(--paper); }
  body.dark .book-mock::before{ background:rgba(178,58,46,0.5); }
  body.dark .founder-stamp{ background:var(--paper-light); }
  .hero h1{ color:#fff !important; }
  .band-dark h2, .band-dark h3{ color:#fff !important; }

  /* ---------------- HERO ---------------- */
  .hero{
    background: radial-gradient(circle at 85% 15%, #17462F 0%, var(--chalk) 55%, var(--chalk-dark) 100%);
    color:#F3EEDD;
    padding:76px 0 96px;
    overflow:hidden;
    position:relative;
  }
  .hero-inner{
    display:grid;
    grid-template-columns:1.1fr 0.9fr;
    gap:56px;
    align-items:center;
  }
  .hero h1{
    color:#fff;
    font-size:clamp(2.1rem, 4.2vw, 3.3rem);
    max-width:11ch;
  }
  .hero p.lede{
    font-size:1.08rem;
    color:#D8D0BB;
    max-width:46ch;
    margin-bottom:2em;
  }
  .btn-row{ display:flex; gap:16px; flex-wrap:wrap; }
  .syllabus-line{
    font-size:0.9rem;
    color:#B7E3C7;
    margin:-0.8em 0 1.6em;
    font-weight:500;
  }
  .btn{
    font-family:'Work Sans', sans-serif;
    font-weight:600;
    font-size:0.98rem;
    padding:14px 26px;
    border-radius:8px;
    text-decoration:none;
    display:inline-flex; align-items:center; gap:8px;
    border:2px solid transparent;
    cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .btn:hover{ transform:translateY(-2px); }
  .btn-primary{
    background:var(--naija);
    color:#fff;
    box-shadow:0 8px 20px rgba(0,129,74,0.35);
  }
  .btn-primary:hover{ background:var(--naija-dark); }
  .btn-outline{
    background:transparent;
    color:#F3EEDD;
    border-color:rgba(243,238,221,0.45);
  }
  .btn-outline:hover{ border-color:#fff; }
  .btn-cta{
    background:var(--gold);
    color:#3A2A05;
    padding:10px 22px;
    font-size:0.92rem;
    box-shadow:0 6px 16px rgba(200,138,46,0.35);
  }
  .btn-cta:hover{ background:#B87D26; }
  @media (max-width:820px){
    .btn-cta{ padding:8px 16px; font-size:0.85rem; }
  }
  .btn-small{
    padding:9px 18px;
    font-size:0.85rem;
    border-radius:6px;
  }

  /* Exercise-book mock card in hero */
  .book-mock{
    position:relative;
    background:var(--paper-light);
    border-radius:6px;
    padding:34px 30px 40px;
    box-shadow:var(--shadow);
    transform:rotate(1.4deg);
    background-image: repeating-linear-gradient(
      to bottom, transparent, transparent 30px, var(--line) 31px
    );
  }
  .book-mock::before{
    content:"";
    position:absolute; left:26px; top:0; bottom:0;
    width:2px; background:rgba(178,58,46,0.35);
  }
  .book-mock h3{
    font-size:1.25rem; margin-bottom:0.3em;
  }
  .book-mock p{ color:var(--ink-soft); margin:0 0 1.1em; font-size:0.95rem;}
  .book-mock .subject-tag{
    display:inline-block;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.7rem;
    letter-spacing:0.06em;
    text-transform:uppercase;
    background:var(--gold);
    color:#3A2A05;
    padding:4px 10px;
    border-radius:4px;
    margin-bottom:14px;
  }

  /* Stamp — signature element, an ink-stamp seal */
  .stamp{
    --size:128px;
    width:var(--size); height:var(--size);
    position:absolute;
    right:-10px; bottom:-18px;
    transform:rotate(-11deg);
  }
  .stamp svg{ width:100%; height:100%; display:block; }
  .stamp-ring{
    fill:none; stroke:var(--stamp); stroke-width:2.4;
  }
  .stamp-ring-dash{
    fill:none; stroke:var(--stamp); stroke-width:1.4; stroke-dasharray:3 4;
  }
  .stamp-check path{
    stroke:var(--stamp); stroke-width:5; fill:none; stroke-linecap:round; stroke-linejoin:round;
  }
  .stamp text{
    fill:var(--stamp);
    font-family:'IBM Plex Mono', monospace;
    font-size:8.6px;
    font-weight:600;
    letter-spacing:2.4px;
  }
  .stamp-inline{
    position:static; transform:rotate(-7deg); right:auto; bottom:auto;
    --size:92px;
  }

  /* ---------------- GENERIC SECTION ---------------- */
  section{ padding:74px 0; }
  .section-head{ max-width:640px; margin-bottom:44px; }
  .section-head p{ color:var(--ink-soft); font-size:1.02rem; }

  .band-alt{ background:var(--paper-light); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .band-dark{ background:var(--chalk); color:#EDE6D3; }
  .band-dark h2, .band-dark h3{ color:#fff; }

  /* ---------------- SUBJECTS: timetable-style grid ---------------- */
  .level-row{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:18px;
    margin-bottom:40px;
  }
  .level-card{
    background:var(--card);
    border:1px solid var(--line);
    border-left:5px solid var(--naija);
    border-radius:8px;
    padding:22px 22px;
    box-shadow:var(--shadow);
  }
  .level-card h3{ font-size:1.05rem; margin-bottom:0.25em; }
  .level-card span.tag{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.68rem;
    color:var(--naija-dark);
    letter-spacing:0.08em;
  }
  .level-card .level-desc{
    color:var(--ink-soft);
    font-size:0.9rem;
    margin:0.5em 0 1.1em;
  }

  .subject-table{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:10px;
    box-shadow:var(--shadow);
    overflow:hidden;
  }
  .subject-row{
    display:grid;
    grid-template-columns:2.2fr 1fr;
    align-items:start;
    padding:20px 26px;
    border-bottom:1px solid var(--line);
  }
  .subject-row:last-child{ border-bottom:none; }
  .subject-row:nth-child(odd){ background:rgba(0,129,74,0.035); }
  .subject-name{ font-weight:600; font-size:1.02rem; }
  .subject-desc{
    color:var(--ink-soft);
    font-size:0.87rem;
    margin:4px 0 0;
    max-width:52ch;
  }
  .subject-row .code{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.78rem;
    color:var(--ink-soft);
    justify-self:end;
    letter-spacing:0.04em;
    padding-top:2px;
  }

  /* ---------------- STUDENTS / TEACHERS ---------------- */
  .lang-band{
    background:var(--chalk);
    padding:48px 0;
  }
  .lang-inner{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:32px;
    flex-wrap:wrap;
  }
  .lang-inner h2{ color:#fff; margin-bottom:0.35em; font-size:1.5rem; }
  .lang-inner p{ color:#D8D0BB; max-width:56ch; margin:0; }
  .lang-inner > div{ flex:1 1 380px; }
  .split{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:26px;
  }
  .panel{
    background:var(--card);
    border-radius:10px;
    padding:32px 30px;
    box-shadow:var(--shadow);
    border-top:5px solid var(--gold);
  }
  .panel.teacher{ border-top-color:var(--naija); }
  .panel h3{ font-size:1.3rem; }
  .panel ul{ padding-left:1.1em; margin:1em 0 0; color:var(--ink-soft); }
  .panel li{ margin-bottom:0.5em; }
  .panel li strong{ color:var(--chalk); }
  body.dark .panel li strong{ color:#8FD9AE; }

  /* ---------------- RESOURCES ---------------- */
  .resource-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(190px, 1fr));
    gap:18px;
  }
  .resource-card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:8px;
    padding:22px 18px;
    text-align:left;
  }
  .resource-card .icon{
    width:38px; height:38px;
    border-radius:50%;
    background:var(--paper);
    display:flex; align-items:center; justify-content:center;
    margin-bottom:14px;
    font-family:'IBM Plex Mono', monospace;
    font-weight:600;
    color:var(--naija-dark);
    font-size:0.85rem;
  }
  .resource-card h4{ font-size:1rem; margin-bottom:0.2em; color:var(--ink); font-family:'Work Sans'; font-weight:700;}
  .resource-card p{ color:var(--ink-soft); font-size:0.9rem; margin:0;}

  /* ---------------- ARTICLES ---------------- */
  .article-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:22px;
  }
  .article-card{
    background:var(--card);
    border-radius:8px;
    padding:24px 22px;
    box-shadow:var(--shadow);
    border-left:4px solid var(--cat, var(--naija));
    position:relative;
  }
  .article-card .cat{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.68rem;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--cat, var(--naija-dark));
    margin-bottom:10px;
    display:inline-block;
  }
  .article-card h4{ font-size:1.05rem; color:var(--chalk); margin-bottom:0.4em; font-family:'Bitter'; }
  .article-card p{ color:var(--ink-soft); font-size:0.9rem; margin:0; }
  .article-card .updated{
    display:block;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.68rem;
    letter-spacing:0.04em;
    text-transform:uppercase;
    color:var(--ink-soft);
    opacity:0.75;
    margin-top:14px;
  }

  /* ---------------- WHY CHOOSE US ---------------- */
  .why-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:16px 32px;
  }
  .why-item{
    display:flex; gap:14px; align-items:flex-start;
    padding:18px 0;
    border-bottom:1px dashed var(--line);
  }
  .why-check{
    flex-shrink:0;
    width:26px; height:26px; border-radius:50%;
    background:var(--naija); color:#fff;
    display:flex; align-items:center; justify-content:center;
    font-size:0.85rem; font-weight:700;
  }
  .why-item p{ margin:0; color:#EDE6D3; }
  .why-item strong{ color:#fff; display:block; margin-bottom:2px; }

  /* ---------------- TESTIMONIALS ---------------- */
  .testimonial-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:22px;
  }
  .testimonial-card{
    background:var(--paper-light);
    border:1px solid var(--line);
    border-radius:10px;
    padding:28px 24px 24px;
    position:relative;
  }
  .testimonial-card .quote-mark{
    font-family:'Bitter', serif;
    font-size:2.6rem;
    color:var(--gold);
    line-height:1;
    display:block;
    margin-bottom:6px;
  }
  .testimonial-card p.quote{
    color:var(--ink-soft);
    font-size:0.98rem;
    margin:0 0 18px;
  }
  .testimonial-who{
    display:flex; align-items:center; gap:12px;
  }
  .testimonial-avatar{
    width:42px; height:42px;
    border-radius:50%;
    background:var(--naija);
    color:#fff;
    display:flex; align-items:center; justify-content:center;
    font-family:'IBM Plex Mono', monospace;
    font-weight:600;
    font-size:0.85rem;
    flex-shrink:0;
  }
  .testimonial-who .name{ font-weight:700; font-size:0.92rem; color:var(--chalk); display:block; }
  .testimonial-who .role{ font-size:0.8rem; color:var(--ink-soft); }

  /* ---------------- TEAM ---------------- */
  .team-grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:22px;
  }
  .team-card{
    text-align:center;
  }
  .team-photo-frame{
    width:130px; height:130px;
    border-radius:50%;
    margin:0 auto 16px;
    overflow:hidden;
    border:4px solid var(--paper-light);
    box-shadow:var(--shadow);
    background:var(--chalk);
  }
  .team-photo-frame img{
    width:100%; height:100%; object-fit:cover; object-position:center 30%;
  }
  .team-initial{
    width:100%; height:100%;
    display:flex; align-items:center; justify-content:center;
    font-family:'Bitter', serif;
    font-weight:700;
    font-size:1.8rem;
    color:#fff;
  }
  .team-card h4{
    font-family:'Bitter', serif;
    color:var(--chalk);
    font-size:1.02rem;
    margin:0 0 2px;
  }
  .team-card .team-role{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.72rem;
    letter-spacing:0.05em;
    text-transform:uppercase;
    color:var(--naija-dark);
  }

  /* ---------------- MISSION / VISION ---------------- */
  .mv-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:26px;
  }
  .mv-card{
    background:var(--paper-light);
    border:1px solid var(--line);
    border-radius:10px;
    padding:30px 28px;
  }
  .mv-card .eyebrow{ margin-bottom:0.6em; }
  .mv-card p{ color:var(--ink-soft); margin:0; }

  /* ---------------- ABOUT ---------------- */
  .about-inner{
    display:grid;
    grid-template-columns:0.85fr 1.15fr;
    gap:48px;
    align-items:center;
  }
  .about-stamp-wrap{ display:flex; flex-direction:column; align-items:center; }
  .about-text p{ color:var(--ink-soft); margin-bottom:1.1em; font-size:1.02rem;}
  .founder-frame{
    position:relative;
    width:220px; height:220px;
    border-radius:50%;
    overflow:hidden;
    border:5px solid var(--card);
    box-shadow:var(--shadow);
    background:var(--chalk);
  }
  .founder-photo{
    width:100%; height:100%;
    object-fit:cover;
    object-position:center 30%;
  }
  .founder-stamp{
    position:absolute;
    right:-14px; bottom:-14px;
