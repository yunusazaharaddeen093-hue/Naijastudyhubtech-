  /* ---- Dark / light mode toggle ---- */
  const themeToggle = document.getElementById('themeToggle');
  function applyTheme(isDark){
    document.body.classList.toggle('dark', isDark);
    themeToggle.textContent = isDark ? '☀️' : '🌙';
  }
  const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  applyTheme(prefersDark);
  themeToggle.addEventListener('click', () => {
    applyTheme(!document.body.classList.contains('dark'));
  });

  /* ---- Back to top button ---- */
  const backToTop = document.getElementById('backToTop');
  window.addEventListener('scroll', () => {
    backToTop.classList.toggle('show', window.scrollY > 400);
  });
  backToTop.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  /* ---- Scroll-triggered reveal animations ---- */
  const revealTargets = document.querySelectorAll(
    '.level-card, .panel, .resource-card, .article-card, .why-item, .mv-card, .testimonial-card, .team-card, .contact-card'
  );
  if ('IntersectionObserver' in window){
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting){
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    revealTargets.forEach(el => io.observe(el));
  } else {
    revealTargets.forEach(el => el.classList.add('in-view'));
  }

  /* ---- Search: filter subjects and articles ---- */
  const searchInput = document.getElementById('siteSearch');
  const noSubjectResults = document.getElementById('noSubjectResults');
  const noArticleResults = document.getElementById('noArticleResults');
  searchInput.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();

    let anySubjectVisible = false;
    document.querySelectorAll('.subject-row').forEach(row => {
      const text = row.querySelector('.subject-name').textContent.toLowerCase();
      const match = text.includes(q);
      row.style.display = match ? '' : 'none';
      if (match) anySubjectVisible = true;
    });
    noSubjectResults.style.display = (q && !anySubjectVisible) ? 'block' : 'none';

    let anyArticleVisible = false;
    document.querySelectorAll('.article-card').forEach(card => {
