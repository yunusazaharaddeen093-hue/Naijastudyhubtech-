            email: email,
            phone: phone,
            name: document.getElementById('customerName').value
        },
        customizations: {
            title: "Naija Study Hub",
            description: currentProduct.title
        },
        callback: (data) => {
            if (data.status === 'successful') {
                alert('✅ Payment received! Download link sent to ' + email);
